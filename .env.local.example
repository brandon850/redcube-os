# ============================================================
# RedCube OS — environment variables
# Copy to .env.local and fill in. VITE_* are exposed to the browser;
# everything else is server-only (Vercel serverless functions) — never VITE_ prefix a secret.
# Vars are grouped by the phase that first needs them.
# ============================================================

# ─── Core: Supabase (Phase 0/1) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only (serverless functions / cron). SUPABASE_URL defaults to VITE_SUPABASE_URL if unset.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Email: Resend (Phase 6 — sequence executor + transactional) ───
# Without RESEND_API_KEY, emails are SIMULATED (logged to email_logs, not sent).
RESEND_API_KEY=

# ─── Cron (Vercel) ──────────────────────────────────────────
# Optional shared secret; if set, the automation cron requires Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# ─── Attract: public SEO audit (Phase 2) ────────────────────
# Base URL the results email links to, e.g. https://app.redcube.co/audit/report
PUBLIC_RESULTS_BASE_URL=

# ─── Google APIs: GSC + PageSpeed (Phase 2 / Phase 5) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PAGESPEED_API_KEY=

# ─── Sell: DocuSign (Phase 3) ───────────────────────────────
DS_INTEGRATION_KEY=
DS_USER_ID=
DS_ACCOUNT_ID=
DS_PRIVATE_KEY=
DS_TEMPLATE_ID=
DS_WEBHOOK_HMAC_KEY=
DS_BASE_URL=
INTERNAL_SIGNER_EMAIL=
INTERNAL_SIGNER_NAME=

# ─── Onboard: Stripe (Phase 4) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Onboard: QuickBooks Online (Phase 4) ───────────────────
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox
QBO_ENCRYPTION_KEY=

# ─── Onboard: ClickUp (Phase 4) ─────────────────────────────
CLICKUP_API_TOKEN=
CLICKUP_SPACE_ID=
